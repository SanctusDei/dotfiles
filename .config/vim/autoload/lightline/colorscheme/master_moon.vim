" One blue-gray status band; mode changes affect text accents only.
let s:bg = ['#343E52', 238]
let s:fg = ['#D6DEED', 189]
let s:muted = ['#7C8AA3', 103]
let s:inactive = ['#272F3F', 236]
let s:purple = ['#BB9AF7', 141]
let s:blue = ['#82AAFF', 111]
let s:cyan = ['#86CFC3', 115]
let s:yellow = ['#E0AF68', 179]
let s:red = ['#F7768E', 210]
let s:p = {'normal': {}, 'inactive': {}, 'insert': {}, 'replace': {}, 'visual': {}, 'tabline': {}}
let s:p.normal.left = [[s:purple, s:bg], [s:fg, s:bg]]
let s:p.normal.middle = [[s:fg, s:bg]]
let s:p.normal.right = [[s:fg, s:bg], [s:muted, s:bg]]
let s:p.normal.error = [[s:red, s:bg]]
let s:p.normal.warning = [[s:yellow, s:bg]]
let s:p.inactive.left = [[s:muted, s:inactive]]
let s:p.inactive.middle = [[s:muted, s:inactive]]
let s:p.inactive.right = [[s:muted, s:inactive]]
let s:p.insert.left = [[s:cyan, s:bg], [s:fg, s:bg]]
let s:p.replace.left = [[s:red, s:bg], [s:fg, s:bg]]
let s:p.visual.left = [[s:blue, s:bg], [s:fg, s:bg]]
let s:p.tabline.left = [[s:muted, s:inactive]]
let s:p.tabline.middle = [[s:muted, s:inactive]]
let s:p.tabline.right = [[s:cyan, s:bg]]
let s:p.tabline.tabsel = [[s:blue, s:bg]]
let g:lightline#colorscheme#master_moon#palette = lightline#colorscheme#flatten(s:p)
